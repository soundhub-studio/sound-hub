// SoundHub Milestone 1 foundation schema.
//
// This is the complete structural foundation for issues #2 through #8. It
// replaces the pre-release Role/ProducerProfile/MusicTrack scaffold. The
// closed behavior states are modeled as Prisma enums (see `enum` declarations
// below); the extensible taxonomies (ServiceCategory, Specialty, PricingUnit)
// are seeded records with stable `key` columns and are not enums. Public DTOs
// never expose raw Prisma models.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  // Prisma 7's `prisma-client` generator emits relative ESM imports
  // without an extension by default. TypeScript preserves those
  // extensionless specifiers into the compiled `.js`, but Node's
  // ESM resolver requires an explicit extension on relative paths.
  // Setting `importFileExtension = "js"` makes the generated TS
  // source import `./internal/class.js` (and `./enums.js`,
  // `./models.js`, etc.), which TypeScript preserves and Node ESM
  // resolves correctly against the compiled output. `tsx` and the
  // API's local dev path are unaffected because they consume the
  // emitted JS through the same `.js` extensions.
  importFileExtension = "js"
  // `partialIndexes` enables the `where:` predicate on @@index /
  // @@unique declarations. BG4 created the partial unique index
  // `project_requests_pending_unique_idx` in
  // 20260827090000_bg4_project_requests/migration.sql; declaring it
  // here keeps future migration diffs from treating the SQL-created
  // index as unexplained drift and prevents `prisma migrate dev`
  // from generating a duplicate CREATE INDEX statement.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Closed behavior states (Prisma enums) ----------

enum WorkspaceType {
  Personal
  Organization
}

enum WorkspaceStatus {
  Active
  Suspended
}

enum WorkspaceMembershipRole {
  Owner
  Admin
  Member
}

enum MarketplaceCapability {
  Buyer
  Seller
}

enum SellerProfileStatus {
  Draft
  Published
  Suspended
}

enum ServiceOfferingStatus {
  Draft
  Active
  Paused
  Archived
}

enum ServiceMode {
  Remote
  InPerson
  Hybrid
}

enum PricingKind {
  StartingAt
  Fixed
  ContactForQuote
}

enum PurchaseMode {
  BundleOnly
}

// Audio sample cleanup lifecycle.
//
//   - `Live`           — visible in buyer-facing discovery; default.
//   - `PendingCleanup` — the seller removed the sample but the
//     storage object could not be deleted (e.g. provider outage).
//     The row is preserved so a bounded retry can complete the
//     bounded object cleanup later. Hidden from buyer-facing
//     discovery immediately.
//   - `Removed`        — the storage object has been removed; the
//     row will be deleted at the next transactional sweep.
enum AudioSampleCleanupStatus {
  Live
  PendingCleanup
  Removed
}

enum ProjectRequestStatus {
  // Seller has not yet responded.
  Pending
  // Seller explicitly accepted; a Negotiating Deal was atomically
  // created. Terminal.
  Accepted
  // Seller explicitly declined. No Deal was created. Terminal.
  Declined
}

enum DealStatus {
  // The seller accepted the ProjectRequest but the parties have not
  // yet both approved a TermsVersion and the buyer has not initiated
  // funding. The Deal can transition to Active only via the
  // deterministic activation invariant owned by a later ticket.
  Negotiating
  // Both parties have approved the same current TermsVersion and
  // the buyer's sandbox funding for that version has been confirmed.
  // Owned by a later ticket; never set in BG4.
  Active
}

// Buildathon Golden Slice 6 (BG6) — PaymentIntent closed lifecycle.
// See ticket #64. The providerState field tracks whether SoundHub has
// durably persisted the intent, the provider has returned a matching
// confirmation, or the provider threw or returned a non-matching
// confirmation. Failed is durable; a buyer retry on the SAME intent
// row transitions Failed → Confirmed.
enum PaymentIntentProviderState {
  Created
  Confirmed
  Failed
}

// Closed set of sanitized reason codes persisted on a Failed
// PaymentIntent. The persisted column carries ONLY this enum value;
// the raw exception text lives in the server-only PaymentIntent.
// failureDetail column and never crosses any public DTO.
enum PaymentIntentFailureReasonCode {
  EscrowProviderUnavailable
  EscrowConfirmationAmountMismatch
  EscrowConfirmationCurrencyMismatch
  EscrowConfirmationVersionMismatch
}

// Closed sanitized failure-detail category. The ONLY persisted
// value allowed alongside `failureReasonCode`. Raw provider
// exception text, stack traces, hostnames, secrets, or stack-frame
// diagnostics are NEVER persisted. See ticket #64 P1-004.
enum PaymentIntentFailureDetailCategory {
  // Provider threw or returned an unparseable response.
  PROVIDER_UNAVAILABLE
  // Provider returned a parseable response that failed strict
  // runtime validation (malformed fields, wrong labels, etc.).
  CONFIRMATION_INVALID
  // Provider returned a parseable response whose amount/currency/
  // termsVersionId did not match the locked snapshot.
  CONFIRMATION_MISMATCH
}

// M2 (#86): closed set of reasons a ServiceOfferingPause evidence
// row can carry. Pause authorization is independent of activation
// completeness; the `user_initiated` reason covers explicit seller
// Pause commands, while `final_sample_removal` records the automatic
// Active → Paused transition when the last qualifying sample is
// removed from an Active offering. The closed set prevents
// fabrication of alternative reasons.
enum ServiceOfferingPauseReason {
  user_initiated
  final_sample_removal
}

// ---------- Identity and authority ----------

model UserAccount {
  id        String   @id @default(cuid())
  // The primary email associated with the account. Owned by SoundHub for
  // display and notification purposes; provider-owned identities live in
  // the IdentityProvider mapping table so a provider change does not
  // rewrite this column. Nullable because the Buildathon Golden Slice
  // introduces identity-only accounts (a user may sign in via a managed
  // provider without SoundHub ever having been told an email).
  email     String?  @unique
  // M2 (#82): pointer to the Personal Workspace this human owns. The
  // unique constraint enforces "at most one Personal Workspace per
  // UserAccount" at the DB boundary. The compare-and-set UPDATE in
  // PersonalWorkspaceConvergenceService is the atomic serialization
  // point that guarantees concurrent first-auth attempts converge on
  // the same Workspace + Owner membership without orphan rows.
  // Nullable only because the column is added via a backfill migration;
  // every authenticated human that completes first-auth provisioning
  // will have this set. ON DELETE RESTRICT means a Personal Workspace
  // cannot be detached implicitly — explicit handling is required.
  personalWorkspaceId String?    @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships             WorkspaceMembership[]
  ownedWorkspaces         Workspace[]           @relation("WorkspaceOwner")
  // M2 (#82): reverse relation to the Personal Workspace this human
  // owns via the `personalWorkspaceId` pointer.
  personalWorkspace       Workspace?            @relation("UserAccountPersonalWorkspace", fields: [personalWorkspaceId], references: [id], onDelete: Restrict)
  identityProviders       IdentityProvider[]
  authSessions            AuthSession[]
  // Briefs the human authored as the buyer-side actor (BG3).
  authoredBriefs          ProjectBrief[]        @relation("BriefCreatedByUser")
  // BG4 ProjectRequests. Two relations: the buyer-side creator and
  // the seller-side decision actor. A NULL sellerDecisionByUserId
  // means the request is still Pending.
  authoredProjectRequests ProjectRequest[]      @relation("ProjectRequestCreatedBy")
  decidedProjectRequests  ProjectRequest[]      @relation("ProjectRequestDecidedBy")
  // BG5 DealApprover authorizations. A UserAccount can be granted
  // the DealApprover authorization for one or more Workspaces
  // (each grants one explicit permission).
  dealApproverAuthorizations DealApprover[]      @relation("DealApproverUser")
  // Audit attribution for who granted the DealApprover authorization.
  // Always populated; the row's invariant (`grantedByUserId` cannot
  // be NULL) is enforced in the migration.
  dealApproverGrants        DealApprover[]      @relation("DealApproverGrantedBy")
  // BG5 TermsVersion drafter attribution. Optional because pure-AI
  // drafts may carry a NULL user id when the application cannot
  // attribute the proposal to a single human.
  draftedTermsVersions       TermsVersion[]      @relation("TermsVersionDraftedBy")
  // BG5 DealApproval attribution. The acting human who clicked
  // "approve" — recorded for audit; the authorization column
  // (`dealApproverId`) is what permits the approval.
  approvedDealApprovals      DealApproval[]      @relation("DealApprovalApprovedBy")
  // BG6 PaymentIntent attribution. The acting human who initiated
  // the funding call (recorded for audit; the Buyer capability +
  // WorkspaceMembership are the authorization sources).
  createdPaymentIntents      PaymentIntent[]     @relation("PaymentIntentCreatedBy")
  // M2 (#84): SellerProfile publication attribution. Recorded for
  // audit; NOT an authorization source. Two relations cover the
  // current-state pointer (`SellerProfile.publishedByUserId`, SET
  // NULL on delete) and the durable evidence row
  // (`SellerProfilePublication.publishedByUserId`, RESTRICT on
  // delete).
  publishedSellerProfiles          SellerProfile[]         @relation("SellerProfilePublishedBy")
  publishedSellerProfilePublications SellerProfilePublication[] @relation("SellerProfilePublicationPublishedBy")
  // M2 (#85): ServiceOffering activation attribution. Recorded
  // for audit; authorization is decided by WorkspaceMembership +
  // Seller capability, NOT by this relation.
  activatedServiceOfferings        ServiceOfferingActivation[] @relation("ServiceOfferingActivationActivatedBy")
  // M2 (#85) PR-review feedback: media-use confirmation attribution
  // for every uploaded audio sample. Recorded for audit; the
  // authorization to upload is decided by Seller capability + the
  // acting Workspace, NOT by this relation.
  confirmedAudioSamples            ServiceOfferingAudioSample[] @relation("ServiceOfferingAudioSampleConfirmedBy")
  // M2 (#85) PR-review feedback: reverse relation on the
  // ServiceOfferingCreation evidence table; ON DELETE RESTRICT on
  // the FK preserves the durable creation record.
  createdServiceOfferings          ServiceOfferingCreation[]   @relation("ServiceOfferingCreationCreatedBy")
  // M2 (#86): reverse relation on the ServiceOfferingPause evidence
  // table. ON DELETE RESTRICT on the FK preserves the durable pause
  // evidence row even if the source UserAccount is hard-deleted.
  pausedServiceOfferings           ServiceOfferingPause[]      @relation("ServiceOfferingPausePausedBy")
  // M2 (#86): reverse relation on the ServiceOfferingUpdate evidence
  // table. ON DELETE RESTRICT on the FK preserves the durable update
  // evidence row even if the source UserAccount is hard-deleted.
  updatedServiceOfferings          ServiceOfferingUpdate[]     @relation("ServiceOfferingUpdateUpdatedBy")
  // M2 (#88): reverse relation on the DealApproverAcceptance evidence
  // table. ON DELETE RESTRICT on the FK preserves the durable
  // acceptance row even if the source UserAccount is hard-deleted.
  dealApproverAcceptances         DealApproverAcceptance[]    @relation("DealApproverAcceptanceUser")
  // M2 (#88): audit attribution for who granted the DealApprover
  // authorization in the JIT setup flow. For Personal-Workspace
  // self-service this is the SAME human (the human accepts the
  // versioned attestation on their own Workspace); for a future
  // Organization flow it would be the Owner/Admin who grants. The
  // column is non-null and ON DELETE RESTRICT preserves the durable
  // audit row.
  dealApproverAcceptanceGrants    DealApproverAcceptance[]    @relation("DealApproverAcceptanceGrantedBy")

  @@map("user_accounts")
}

// IdentityProvider maps a managed provider's subject identifier to a
// durable SoundHub UserAccount. The (provider, subject) tuple is unique
// so the same provider subject cannot accidentally create duplicate
// accounts on repeat sign-in. Provider subjects, claims, roles, and
// metadata never identify or authorize a Workspace; they only resolve
// to a UserAccount. See ADR 0004 (External authentication proves login
// only) for the architectural split.
model IdentityProvider {
  id            String   @id @default(cuid())
  // Stable provider key, e.g. "managed-magic-link" or "deterministic".
  provider      String
  // The provider's unique identifier for this human. Opaque to
  // SoundHub; never exposed in public DTOs.
  subject       String
  // The email the provider knows the user by, when applicable. Optional
  // because some provider configurations do not surface email.
  providerEmail String?
  userAccountId String
  createdAt     DateTime @default(now())

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userAccountId])
  @@map("identity_providers")
}

// AuthSession is a server-issued, opaque session handle. The browser
// receives the id as an HttpOnly cookie; the server resolves it back
// to the authenticated UserAccount on every protected request. The
// client cannot assert an arbitrary UserAccount because the session
// id is the only authoritative identity signal. Revocation is recorded
// rather than deleted so audit evidence survives the lifetime of the
// session.
model AuthSession {
  id            String    @id @default(cuid())
  userAccountId String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@index([userAccountId])
  @@map("auth_sessions")
}

model Workspace {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  type        WorkspaceType
  status      WorkspaceStatus @default(Active)
  ownerUserId String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner                 UserAccount           @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  // M2 (#82): reverse relation. The Personal Workspace relationship
  // is established by setting UserAccount.personalWorkspaceId (the
  // compare-and-set UPDATE in the convergence service). This is the
  // single source of truth for "which human owns this Personal
  // Workspace"; the legacy `ownerUserId` column is M1.1 metadata only
  // and never authorizes by itself (GS 5 invariant).
  personalOwners        UserAccount[]         @relation("UserAccountPersonalWorkspace")
  memberships           WorkspaceMembership[]
  capabilities          WorkspaceCapability[]
  sellerProfile         SellerProfile?
  // Briefs authored under this Workspace as the buyer (BG3). A
  // Workspace must hold the Buyer capability at brief-creation time.
  buyerBriefs           ProjectBrief[]        @relation("BuyerWorkspaceBriefs")
  // BG4 ProjectRequests referencing this Workspace as either side.
  // The buyer side is gated on the Buyer capability at create time;
  // the seller side is gated on the Seller capability (and a
  // matching SellerProfile / ServiceOffering ownership) at create
  // time and on current WorkspaceMembership at accept/decline time.
  buyerProjectRequests  ProjectRequest[]      @relation("BuyerWorkspaceProjectRequests")
  sellerProjectRequests ProjectRequest[]      @relation("SellerWorkspaceProjectRequests")
  // BG4 Deals referencing this Workspace as either side. The
  // accepted ProjectRequest's buyer/seller workspaces are copied
  // onto the Deal so authorization can revalidate them without
  // joining through ProjectRequest.
  buyerDeals            Deal[]                @relation("BuyerWorkspaceDeals")
  sellerDeals           Deal[]                @relation("SellerWorkspaceDeals")
  // BG5 DealApprover authorizations. A Workspace may grant one or
  // more explicit DealApprover authorizations; each row binds the
  // Workspace to a single (current) member who may approve an
  // immutable TermsVersion on the Workspace's behalf. Being
  // authenticated, being an Owner, or possessing Buyer/Seller
  // capability does NOT record approval — only this row does.
  dealApprovers         DealApprover[]
  // BG5 DealApproval records. Convenience reverse relation; the
  // approval's authorization is determined by the joined DealApprover
  // row, not by this relation.
  approvals             DealApproval[]
  // BG6 reverse relation: every durable PaymentIntent whose intent
  // (provider.call, preauth, or activation) was initiated by this
  // Workspace. Always the buyer Workspace; the activation invariant
  // rejects seller-side intents at the service layer.
  paymentIntents        PaymentIntent[]
  // M2 (#84): narrow append-only publication evidence. The reverse
  // relation on the SellerProfilePublication table; ON DELETE
  // RESTRICT on the FK preserves the durable evidence row.
  sellerProfilePublications SellerProfilePublication[]
  // M2 (#85): narrow append-only activation evidence. The reverse
  // relation on the ServiceOfferingActivation table; ON DELETE
  // RESTRICT on the FK preserves the durable evidence row.
  serviceOfferingActivations ServiceOfferingActivation[]
  // M2 (#85) PR-review feedback: narrow append-only creation
  // evidence. The reverse relation on the ServiceOfferingCreation
  // table; ON DELETE RESTRICT on the FK preserves the durable
  // evidence row.
  serviceOfferingCreations   ServiceOfferingCreation[]
  // M2 (#86): narrow append-only pause evidence. The reverse
  // relation on the ServiceOfferingPause table; ON DELETE RESTRICT
  // on the FK preserves the durable pause evidence row.
  serviceOfferingPauses     ServiceOfferingPause[]
  // M2 (#86): narrow append-only update evidence. The reverse
  // relation on the ServiceOfferingUpdate table; ON DELETE RESTRICT
  // on the FK preserves the durable update evidence row.
  serviceOfferingUpdates    ServiceOfferingUpdate[]
  // M2 (#88): reverse relation on the DealApproverAcceptance
  // evidence table; ON DELETE RESTRICT on the FK preserves the
  // durable acceptance row even if the Workspace is hard-deleted.
  dealApproverAcceptances   DealApproverAcceptance[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String                  @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceMembershipRole
  createdAt   DateTime                @default(now())

  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_memberships")
}

model WorkspaceCapability {
  id          String                @id @default(cuid())
  workspaceId String
  capability  MarketplaceCapability

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, capability])
  @@map("workspace_capabilities")
}

// ---------- Seller discovery ----------

model SellerProfile {
  id                 String              @id @default(cuid())
  workspaceId        String              @unique
  professionalName   String
  bio                String
  status             SellerProfileStatus @default(Draft)
  basedInCity        String?
  basedInRegion      String?
  // M2 #84 acceptance: "Incomplete pre-publication Drafts remain
  // private, resumable, absent from public DTOs, and presented as
  // Private draft." The draft may persist without a
  // `basedInCountryCode`; publish/update completeness enforces it.
  basedInCountryCode String?
  avatarUrl          String?
  // M2 (#84): convenience current-state columns that cache the
  // latest publication metadata for fast reads. NOT the durable
  // evidence — see SellerProfilePublication for the append-only
  // audit trail. ON DELETE SET NULL on publishedByUserId so a
  // hard-deleted UserAccount does not cascade-erase the publication
  // timestamp on a profile that still belongs to an active Workspace.
  publishedAt        DateTime?
  publishedByUserId  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  workspace             Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishedByUser       UserAccount?               @relation("SellerProfilePublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  specialties           SellerProfileSpecialty[]
  caribbeanAffiliations CaribbeanAffiliation[]
  offerings             ServiceOffering[]
  publications          SellerProfilePublication[]
  // M2 (#85): reverse relation on the ServiceOfferingActivation
  // evidence table; ON DELETE RESTRICT on the FK preserves the
  // durable evidence row.
  offeringActivations   ServiceOfferingActivation[]
  // M2 (#86): reverse relation on the ServiceOfferingPause evidence
  // table. ON DELETE RESTRICT on the FK preserves the durable pause
  // evidence row.
  serviceOfferingPauses ServiceOfferingPause[]
  // M2 (#86): reverse relation on the ServiceOfferingUpdate evidence
  // table. ON DELETE RESTRICT on the FK preserves the durable update
  // evidence row.
  serviceOfferingUpdates ServiceOfferingUpdate[]

  @@index([status, updatedAt], map: "seller_profiles_status_updatedAt_idx")
  @@map("seller_profiles")
}

// M2 (#84): narrow append-only publication evidence. Mirrors the
// DealApproval pattern at packages/db/prisma/schema.prisma around
// line 1013. Each successful Publish / Update creates ONE row; the
// (workspaceId, idempotencyKey) unique constraint is the second
// defense against transport-retry duplicates (the first defense is
// the application-layer pre-transaction check in SellerProfileService).
// ON DELETE RESTRICT on every FK preserves the durable evidence row
// even if the source UserAccount, Workspace, or SellerProfile is
// ever hard-deleted.
model SellerProfilePublication {
  id                  String   @id @default(cuid())
  publishedByUserId   String
  workspaceId         String
  sellerProfileId     String
  confirmationVersion String
  publishedAt         DateTime @default(now())
  // Client-supplied UUID generated when a new publication attempt
  // begins. Retained across uncertain transport outcomes and explicit
  // Retry actions; cleared only on definitive success or user-initiated
  // payload change. See SellerProfileService for retry semantics.
  idempotencyKey      String
  // The sanitized HTTP request correlation id from the boundary
  // middleware (apps/api/src/lib/request-id.ts). Mirrors DealApproval's
  // narrow audit attribution.
  requestId           String

  publishedBy   UserAccount    @relation("SellerProfilePublicationPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sellerProfile SellerProfile  @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey], map: "seller_profile_publications_workspace_idem_unique_idx")
  @@index([sellerProfileId, publishedAt(sort: Desc)], map: "seller_profile_publications_profile_publishedAt_idx")
  @@map("seller_profile_publications")
}

model Specialty {
  id   String @id @default(cuid())
  key  String @unique
  name String

  profiles SellerProfileSpecialty[]

  @@map("specialties")
}

model SellerProfileSpecialty {
  sellerProfileId String
  specialtyId     String

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  specialty     Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@id([sellerProfileId, specialtyId])
  @@map("seller_profile_specialties")
}

model CaribbeanAffiliation {
  id              String @id @default(cuid())
  sellerProfileId String
  countryCode     String

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@unique([sellerProfileId, countryCode])
  @@index([countryCode])
  @@map("caribbean_affiliations")
}

// ---------- Extensible taxonomies ----------

model ServiceCategory {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  // `bundleOnly` is reserved for categories that are only purchasable as part
  // of an offering bundle. The 10 initial approved categories are all
  // independently purchasable (bundleOnly = false).
  bundleOnly  Boolean  @default(false)
  createdAt   DateTime @default(now())

  primaryOfferings         ServiceOffering[] @relation("PrimaryCategory")
  includedServiceOfferings IncludedService[]

  @@map("service_categories")
}

model PricingUnit {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())

  pricingOptions ServiceOfferingPricing[]

  @@map("pricing_units")
}

// ---------- Service offerings ----------

model ServiceOffering {
  id                String                @id @default(cuid())
  slug              String                @unique
  sellerProfileId   String
  title             String
  description       String
  status            ServiceOfferingStatus @default(Draft)
  // M2 (#85): serviceMode and primaryCategoryId are nullable on
  // Draft so the seller can save a partial draft without silently
  // fabricating a mode or category they never chose. Activation
  // requires both at the trusted boundary; the search filter
  // already requires non-null on Active rows because the existing
  // eligibility predicate (`status = Active`) excludes Draft.
  serviceMode       ServiceMode?
  primaryCategoryId String?
  genreTags         String[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  sellerProfile        SellerProfile                @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  primaryCategory      ServiceCategory?             @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  includedServices     IncludedService[]
  serviceAreas         ServiceOfferingServiceArea[]
  pricing              ServiceOfferingPricing?
  audioSamples         ServiceOfferingAudioSample[]
  orphanedAudioStorage AudioSampleOrphanedStorage[]
  // M2 (#85): narrow append-only activation evidence. Mirrors the
  // SellerProfilePublication pattern; one row per successful
  // activation. The (offeringId, idempotencyKey) unique constraint
  // is the second defense against transport-retry duplicates (the
  // first defense is the application-layer pre-check in
  // ServiceOfferingService.activate). ON DELETE RESTRICT on every
  // FK preserves the durable evidence even if the source records
  // are hard-deleted.
  activations          ServiceOfferingActivation[]
  // M2 (#85) PR-review feedback: reverse relation on the
  // ServiceOfferingCreation evidence table.
  creations            ServiceOfferingCreation[]
  // M2 (#86): reverse relation on the ServiceOfferingPause evidence
  // table. ON DELETE RESTRICT on the FK preserves the durable pause
  // evidence row.
  pauses               ServiceOfferingPause[]
  // M2 (#86): reverse relation on the ServiceOfferingUpdate evidence
  // table. ON DELETE RESTRICT on the FK preserves the durable update
  // evidence row.
  updates              ServiceOfferingUpdate[]
  // BG4 references: a ServiceOffering can be selected by many
  // ProjectRequests over time and become the basis for many Deals.
  // RESTRICT on delete prevents an offering from being removed
  // while it is referenced.
  projectRequests      ProjectRequest[]
  deals                Deal[]

  @@index([sellerProfileId])
  @@index([primaryCategoryId])
  @@index([status])
  @@map("service_offerings")
}

// M2 (#85): narrow append-only ServiceOffering activation evidence.
// Each successful activation creates ONE row; same-attempt retry
// transport duplicates are rejected by the (offeringId, idempotencyKey)
// unique constraint. The service does the pre-check too so the DB
// constraint is the second defense, not the first.
model ServiceOfferingActivation {
  id                  String   @id @default(cuid())
  offeringId          String
  workspaceId         String
  sellerProfileId     String
  // The acting human who clicked "Activate". Recorded for audit;
  // authorization is decided by WorkspaceMembership + Seller
  // capability, NOT by this column.
  activatedByUserId   String
  confirmationVersion String
  activatedAt         DateTime @default(now())
  // Client-supplied UUID generated when a new activation attempt
  // begins. Retained across uncertain transport outcomes and Retry
  // actions; cleared only on definitive success or user-initiated
  // payload change.
  idempotencyKey      String
  requestId           String

  offering      ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sellerProfile SellerProfile  @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  activatedBy   UserAccount    @relation("ServiceOfferingActivationActivatedBy", fields: [activatedByUserId], references: [id], onDelete: Restrict)

  @@unique([offeringId, idempotencyKey], map: "service_offering_activations_offering_idem_unique_idx")
  @@index([offeringId, activatedAt(sort: Desc)], map: "service_offering_activations_offering_activatedAt_idx")
  @@index([workspaceId], map: "service_offering_activations_workspace_idx")
  @@map("service_offering_activations")
}

// M2 (#85) PR-review feedback: narrow append-only ServiceOffering
// creation evidence. Each successful `createDraft` produces ONE
// row carrying the new offeringId + the (workspaceId, idempotencyKey)
// unique key. The application-layer pre-check is the first defense;
// this DB unique index is the second defense so a transport retry
// with the same idempotencyKey converges on the SAME offeringId, and
// a deliberate second click (a new idempotencyKey) creates a NEW
// offering. Mirrors the SellerProfilePublication pattern. ON DELETE
// RESTRICT on every FK preserves the durable evidence even if the
// source UserAccount, Workspace, or SellerProfile is hard-deleted.
model ServiceOfferingCreation {
  id                String   @id @default(cuid())
  offeringId        String
  workspaceId       String
  createdByUserId   String
  createdAt         DateTime @default(now())
  // Client-supplied UUID generated when the user clicks "Create
  // service". The (workspaceId, idempotencyKey) tuple is the unique
  // convergence key.
  idempotencyKey    String
  requestId         String

  offering      ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy     UserAccount    @relation("ServiceOfferingCreationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey], map: "service_offering_creations_workspace_idem_unique_idx")
  @@index([offeringId], map: "service_offering_creations_offering_idx")
  @@map("service_offering_creations")
}

// M2 (#86): narrow append-only ServiceOfferingPause evidence.
//
// Pause authorization is INDEPENDENT of activation completeness — a
// grandfathered nonconforming Active offering must remain pausable
// without satisfying the activation contract. Pause therefore records
// only the facts established by the Pause command and does NOT carry an
// activation `confirmationVersion` column. Fabricating such a column
// would invent an attestation that the Pause command did not invoke.
//
// Each successful Pause (explicit user-initiated or the atomic
// Active → Paused transition triggered by final-sample removal) creates
// ONE row; same-attempt retry transport duplicates are rejected by the
// (offeringId, idempotencyKey) unique constraint. ON DELETE RESTRICT
// on every FK preserves the durable evidence row even if the source
// UserAccount, Workspace, or SellerProfile is hard-deleted.
model ServiceOfferingPause {
  id              String                     @id @default(cuid())
  offeringId      String
  workspaceId     String
  sellerProfileId String
  pausedByUserId  String
  pausedAt        DateTime                   @default(now())
  // Closed enum recording WHY the offering was paused. No other
  // values are accepted; fabrication of alternative reasons is
  // prohibited by the schema.
  reason          ServiceOfferingPauseReason
  // Client-supplied UUID generated when a new Pause attempt begins.
  // Retained across uncertain transport outcomes and explicit Retry
  // actions; cleared only on definitive success or user-initiated
  // payload change.
  idempotencyKey  String
  requestId       String

  offering      ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sellerProfile SellerProfile  @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  pausedBy      UserAccount    @relation("ServiceOfferingPausePausedBy", fields: [pausedByUserId], references: [id], onDelete: Restrict)

  @@unique([offeringId, idempotencyKey], map: "service_offering_pauses_offering_idem_unique_idx")
  @@index([offeringId, pausedAt(sort: Desc)], map: "service_offering_pauses_offering_pausedAt_idx")
  @@index([workspaceId], map: "service_offering_pauses_workspace_idx")
  @@map("service_offering_pauses")
}

// M2 (#86): narrow append-only ServiceOfferingUpdate evidence.
//
// Required for durable same-idempotency-key retry convergence on the
// `updateActive` command. A successful Active → Active update does
// NOT rewrite or create ServiceOfferingActivation evidence; the
// activation timestamp from the original Draft → Active transition
// is preserved verbatim per ADR 0008.
//
// `confirmationVersion` carries the same closed enum value as
// activation ("m2-service-activation-v1") because `updateActive`
// re-runs the complete activation contract. Failure preserves the
// prior public state; on success, the public fields are replaced
// atomically and one new Update row is appended.
//
// Same-attempt retry transport duplicates are rejected by the
// (offeringId, idempotencyKey) unique constraint. ON DELETE RESTRICT
// on every FK preserves the durable evidence row.
model ServiceOfferingUpdate {
  id                  String   @id @default(cuid())
  offeringId          String
  workspaceId         String
  sellerProfileId     String
  updatedByUserId     String
  confirmationVersion String
  updatedAt           DateTime @default(now())
  idempotencyKey      String
  requestId           String

  offering      ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sellerProfile SellerProfile  @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  updatedBy     UserAccount    @relation("ServiceOfferingUpdateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([offeringId, idempotencyKey], map: "service_offering_updates_offering_idem_unique_idx")
  @@index([offeringId, updatedAt(sort: Desc)], map: "service_offering_updates_offering_updatedAt_idx")
  @@index([workspaceId], map: "service_offering_updates_workspace_idx")
  @@map("service_offering_updates")
}

model IncludedService {
  id           String       @id @default(cuid())
  offeringId   String
  categoryId   String
  purchaseMode PurchaseMode

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([offeringId, categoryId])
  @@map("included_services")
}

model ServiceOfferingServiceArea {
  id          String  @id @default(cuid())
  offeringId  String
  city        String?
  region      String?
  countryCode String

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId])
  @@index([countryCode])
  @@map("offering_service_areas")
}

model ServiceOfferingPricing {
  id          String      @id @default(cuid())
  offeringId  String      @unique
  kind        PricingKind
  amountMinor Int?
  currency    String?
  unitId      String?

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  unit     PricingUnit?    @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@map("offering_pricing")
}

// ---------- ProjectBrief (Buildathon Golden Slice 3) ----------
//
// A Workspace-owned record of the buyer's natural-language creative
// need. Created under an explicitly acting Buyer-capable Workspace
// (per GS 4 / GS 6). Carries the verbatim original text, the
// validated required constraints and preferences produced by the
// Matchmaker AI boundary (with provenance: AI provider key + model
// id + fallback flag), and the non-search project requirements that
// are useful downstream but never influence eligibility. The Brief is
// immutable: once persisted it is the source of truth for what the
// buyer asked. Any change creates a new Brief row; we never mutate an
// existing one in place. This makes the ProjectRequest revalidation
// step trivially safe (the buyer's intended criteria cannot drift
// after persistence).
model ProjectBrief {
  id                        String   @id @default(cuid())
  buyerWorkspaceId          String
  // The acting human who authored the brief. Recorded for audit; not
  // an authorization signal (Workspace membership is).
  createdByUserId           String
  // The verbatim text the buyer submitted (trimmed + collapsed; full
  // normalisation rules live in @soundhub/types).
  originalText              String
  // Validated required criteria, JSON-encoded per the shared Zod
  // TalentSearchRequiredCriteriaV1 schema. Required constraints may
  // never be silently relaxed by AI or fallback behaviour.
  requiredCriteriaJson      Json
  // Normalised buyer query (per normalizedQuerySchema). Persisted
  // alongside the required/preferred axes so a brief whose criteria
  // surface only a query (e.g. the deterministic fallback when the
  // buyer named no recognised category / location / mode) round-
  // trips through the schema without dropping the axis.
  criteriaQueryJson         Json?
  // Validated preferred criteria (may be absent when the buyer did
  // not express any preference signal).
  preferredCriteriaJson     Json?
  // Non-search project requirements (e.g. funding deadline, scope
  // hints captured by the brief). Persisted as a free-form JSON
  // blob so the brief can carry whatever the buyer asked without
  // being forced to extend the search contract. NOT consumed by the
  // TalentSearchService.
  nonSearchRequirementsJson Json?
  // Provenance: which AI adapter produced the validated criteria
  // (managed or deterministic-fallback) and the adapter-supplied
  // model id (null for the deterministic fallback). Recorded so the
  // UI can disclose provenance and so audits can prove which path
  // produced the result. `aiFallbackUsed: true` means the
  // deterministic fallback crossed the same validation +
  // TalentSearchService boundary (per the BG3 ticket).
  aiProvider                String
  aiModelId                 String?
  aiFallbackUsed            Boolean
  createdAt                 DateTime @default(now())

  buyerWorkspace  Workspace           @relation("BuyerWorkspaceBriefs", fields: [buyerWorkspaceId], references: [id], onDelete: Cascade)
  createdByUser   UserAccount         @relation("BriefCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  searchResults   BriefSearchResult[]
  // BG4 reverse relations: a Brief may be referenced by zero or
  // more ProjectRequests (and therefore by the Deals that follow
  // accepted ones).
  projectRequests ProjectRequest[]
  deals           Deal[]

  @@index([buyerWorkspaceId, createdAt])
  @@map("project_briefs")
}

// BriefSearchResult records the eligibility-determined recommendations
// the Matchmaker surfaced for a ProjectBrief. Persisted so the buyer
// can re-render the same recommendations without re-running the
// brief, and so the later ProjectRequest step can revalidate against
// the same evidence (the selection must reference an offering that
// surfaced here).
//
// The Matchmaker returns at most 10 eligible sellers (per the
// TalentSearchService contract); we persist all returned results so
// the revalidation step can prove the selected offering appeared in
// this list at brief time. The `matchReason` and coverage counts are
// persisted verbatim — they are factual evidence (matched fields,
// preference atom coverage, query token coverage), never derived from
// relevanceScore.
model BriefSearchResult {
  id                       String @id @default(cuid())
  briefId                  String
  // Deterministic ordering position within the brief result list.
  // 1-based; ties on the bounded score are broken by sellerId asc
  // (TalentSearchService contract).
  resultPosition           Int
  sellerId                 String
  // The marketplace-shaped public seller summary as returned by the
  // search. Persisted as JSON so the buyer can re-render without
  // depending on whether the seller is still eligible.
  sellerSnapshotJson       Json
  // The selected best-matching offering's id and snapshot.
  bestOfferingId           String
  bestOfferingSnapshotJson Json
  // Up to two additional standalone matching offerings that
  // surfaced alongside the best match. Persisted as a JSON array
  // (empty when the seller only had one eligible offering) so the
  // buyer can see the full eligibility evidence without a
  // follow-up search and so the later ProjectRequest step can
  // revalidate against the same context.
  additionalOfferingsJson  Json
  relevanceScore           Float
  matchReason              String
  preferenceCoverageJson   Json?
  textCoverageJson         Json?

  brief ProjectBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@unique([briefId, resultPosition])
  @@index([briefId])
  @@index([sellerId])
  @@map("brief_search_results")
}

// ---------- Buildathon Golden Slice 2 (BG2): audio discovery samples ----------
//
// Per ticket #61 a ServiceOffering owns zero through three
// `ServiceOfferingAudioSample` records. Each sample is a bounded MP3
// discovery attachment; this is NOT a PortfolioItem, playlist, catalog
// asset, licensed work, or DealDeliverable. PostgreSQL is canonical
// for the metadata (id, owning offering, buyer-facing label, declared
// MIME type, byte size, deterministic display order, opaque storage
// reference). The bounded object bytes live in replaceable external
// storage (Supabase Storage in production; deterministic fixtures in
// tests). Storage credentials, bucket names, and private object keys
// never cross public DTOs.
//
// The display order is owned by the seller (no drag-and-drop, no
// reordering UI), the MIME type is "audio/mpeg" only, and the size is
// capped at 25 MB. The opaque storage reference is the single
// handoff between PostgreSQL and the provider-neutral storage adapter;
// the storage adapter alone can resolve it back to a playable
// reference.
model ServiceOfferingAudioSample {
  id                   String                   @id @default(cuid())
  offeringId           String
  // Buyer-facing title or label rendered in the discovery UI. Allowed
  // length is bounded; the storage adapter never sees this value.
  label                String
  // Declared MIME type. The application enforces audio/mpeg at the
  // trusted boundary; the column captures the value the seller
  // declared at upload time.
  contentType          String
  // Observed byte size. The application enforces the 25 MB cap at
  // the trusted boundary so a seller cannot smuggle a larger file by
  // declaring a smaller content type.
  byteSize             Int
  // Deterministic seller-owned display order. The seller assigns this
  // value at upload time (e.g. "1, 2, 3") so removal + re-upload does
  // not silently re-order the buyer-facing discovery list.
  displayOrder         Int
  // Opaque storage reference handed back by the StorageAdapter. The
  // application treats it as an opaque string; only the adapter that
  // produced it can resolve it back to a playable reference.
  storageRef           String
  // Cleanup lifecycle (ticket #61 follow-up review P1-005). Default
  // `Live`. `PendingCleanup` means the seller removed the sample but
  // the bounded object could not be deleted at provider removal time;
  // the row is preserved so a bounded retry can complete the
  // cleanup. `Removed` is a transient state during the row delete.
  cleanupStatus        AudioSampleCleanupStatus @default(Live)
  // Number of storage-removal attempts that have failed for this
  // row while it is in `PendingCleanup`. Bounded by the application
  // (no generalized retry infrastructure).
  cleanupAttempts      Int                      @default(0)
  // Last cleanup failure timestamp (UTC). Used to surface the most
  // recent provider failure without logging the provider error
  // message.
  cleanupLastFailureAt DateTime?
  // M2 (#85) PR-review feedback: durable media-use confirmation.
  // The seller must tick the current version of the media-use
  // acknowledgement in the editor before each upload; the
  // application boundary carries the closed version (e.g.
  // `m2-audio-confirmation-v1`), the actor, and the timestamp
  // alongside the sample. Activation completeness counts only
  // samples where these fields are populated and match the current
  // version. NULL on legacy rows from before this column existed.
  confirmationVersion  String?
  confirmedByUserId    String?
  confirmedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  offering    ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  // Audit attribution only. ON DELETE RESTRICT preserves the
  // durable confirmation record even if the human is later hard-
  // deleted. Future uploads re-validate current membership.
  confirmedBy UserAccount?    @relation("ServiceOfferingAudioSampleConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)

  @@index([offeringId])
  @@index([cleanupStatus])
  @@index([offeringId, confirmationVersion], map: "offering_audio_samples_confirmation_idx")
  @@map("offering_audio_samples")
}

// Audio sample orphaned storage locator.
//
// Per ticket #61 follow-up review (P1-002): when an upload succeeds
// in storage but the DB counterpart never persists (DB write fails or
// the cap guard rejects the row), and the immediate storage-delete
// also fails, the storage reference would otherwise be lost. This
// table is the durable recovery record: a row keyed by `storageRef`
// carries the offering id and a bounded retry counter so the next
// operation against the offering can discover and complete the
// storage-side cleanup. Rows are deleted when the storage-side
// delete confirms success or the storage object is reported
// already-gone.
model AudioSampleOrphanedStorage {
  storageRef           String    @id
  // Owning offering. Used to scope the bounded retry pass and to
  // cascade when the offering is removed.
  offeringId           String
  // Number of storage-removal attempts that have failed for this
  // orphan. Bounded by the application (no generalized retry
  // infrastructure).
  cleanupAttempts      Int       @default(0)
  // Last cleanup failure timestamp (UTC).
  cleanupLastFailureAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId])
  @@map("audio_sample_orphaned_storage")
}

// ---------- Buildathon Golden Slice 4 (BG4) ----------
//
// ProjectRequest is a buyer Workspace's invitation to a seller
// Workspace to discuss a project. Seller acceptance opens
// negotiation but does not approve terms or activate paid work
// (CONTEXT.md: "ProjectRequest — A buyer Workspace's invitation to a
// seller Workspace to discuss a project. Seller acceptance opens
// negotiation but does not approve terms or activate paid work.").
//
// Required statuses (per ticket #62): `Pending | Accepted | Declined`.
// Pending is the only non-terminal state; Accepted and Declined are
// terminal and cannot be reversed in this slice.
//
// The unique constraint on `projectRequestId` in the Deal table
// prevents retries from creating multiple Deals for one accepted
// ProjectRequest (GS 26). The partial unique index
// `(buyerWorkspaceId, sellerWorkspaceId, serviceOfferingId,
// projectBriefId) WHERE status = 'Pending'` prevents inappropriate
// duplicate Pending ProjectRequests while still allowing the buyer
// to send a follow-up request after a Decline or a closed Deal.
//
// Every consequential reference (buyer / seller Workspace, deciding
// UserAccount, owning ProjectBrief, owning ServiceOffering) uses
// `onDelete: Restrict` so deleting a Workspace, deciding user, or
// referenced record fails closed rather than erasing consent and
// audit evidence. Workspace removal in the buildathon is
// out-of-scope; archival semantics will land in a later ticket.
model ProjectRequest {
  id                     String               @id @default(cuid())
  buyerWorkspaceId       String
  sellerWorkspaceId      String
  serviceOfferingId      String
  projectBriefId         String
  // The acting human who created the request. Recorded for audit;
  // authorization is decided by WorkspaceMembership, not by this
  // column.
  createdByUserId        String
  status                 ProjectRequestStatus @default(Pending)
  // Set the moment the seller accepts OR declines. Null while
  // Pending. Used by the seller inbox to render ordering.
  sellerDecisionAt       DateTime?
  // The acting seller human who issued the decision. Null while
  // Pending. Recorded for audit (the workspace authorization was
  // revalidated at decision time).
  sellerDecisionByUserId String?
  // Set the moment the seller accepts the request. Equivalent to
  // `sellerDecisionAt` when status = Accepted; null otherwise.
  // Persisted as a separate column because it is the canonical
  // "explicit seller consent" evidence referenced by GS 18 and by
  // every future activation invariant.
  sellerConsentAt        DateTime?
  createdAt              DateTime             @default(now())

  buyerWorkspace   Workspace       @relation("BuyerWorkspaceProjectRequests", fields: [buyerWorkspaceId], references: [id], onDelete: Restrict)
  sellerWorkspace  Workspace       @relation("SellerWorkspaceProjectRequests", fields: [sellerWorkspaceId], references: [id], onDelete: Restrict)
  serviceOffering  ServiceOffering @relation(fields: [serviceOfferingId], references: [id], onDelete: Restrict)
  projectBrief     ProjectBrief    @relation(fields: [projectBriefId], references: [id], onDelete: Restrict)
  createdByUser    UserAccount     @relation("ProjectRequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sellerDecisionBy UserAccount?    @relation("ProjectRequestDecidedBy", fields: [sellerDecisionByUserId], references: [id], onDelete: Restrict)

  deal Deal?

  // Partial unique index mirrors
  // `project_requests_pending_unique_idx` created in
  // 20260827090000_bg4_project_requests/migration.sql. The same
  // column list, index name, and `WHERE status = 'Pending'`
  // predicate are preserved here so a future `prisma migrate diff`
  // treats the SQL-created index as expected schema state rather
  // than as drift to reconcile. The `where:` predicate is the
  // partial-index preview feature; the `map:` argument pins the
  // underlying SQL index name. Closing over `status = 'Pending'`
  // — the only non-terminal state — keeps terminal rows from
  // blocking legitimate re-engagement.
  @@unique([buyerWorkspaceId, sellerWorkspaceId, serviceOfferingId, projectBriefId], map: "project_requests_pending_unique_idx", where: { status: "Pending" })
  @@index([buyerWorkspaceId, status, createdAt])
  @@index([sellerWorkspaceId, status, createdAt])
  @@index([serviceOfferingId])
  @@index([projectBriefId])
  @@map("project_requests")
}

// Deal is an accepted commercial engagement between buyer and seller
// Workspaces (CONTEXT.md: "Deal — An accepted commercial engagement
// between buyer and seller Workspaces. It becomes Active only after
// both parties approve the same TermsVersion and escrow funding
// succeeds.").
//
// The BG4 slice creates exactly one Deal in `Negotiating` per accepted
// ProjectRequest; the (projectRequestId) unique constraint prevents
// retries from creating a second Deal (GS 26). Transitions to Active
// are owned by a later ticket (Deal/TermsVersion/approvals) and never
// happen in BG4.
//
// Every consequential reference uses `onDelete: Restrict` so
// deleting the buyer / seller Workspace, the originating
// ProjectRequest, the referenced ProjectBrief, or the referenced
// ServiceOffering fails closed rather than erasing the accepted
// engagement and its audit evidence.
model Deal {
  id                String     @id @default(cuid())
  buyerWorkspaceId  String
  sellerWorkspaceId String
  serviceOfferingId String
  projectBriefId    String
  // Natural uniqueness: exactly one Deal per accepted
  // ProjectRequest. A retried accept on the same already-accepted
  // request cannot create a second row because the unique index
  // fails the insert.
  projectRequestId  String     @unique
  status            DealStatus @default(Negotiating)
  // Set when the deterministic activation invariant transitions the
  // Deal to Active. Always null in BG4 (Active transitions are
  // owned by a later ticket); included now so the column exists
  // when the activation invariant lands.
  activatedAt       DateTime?
  createdAt         DateTime   @default(now())

  buyerWorkspace  Workspace       @relation("BuyerWorkspaceDeals", fields: [buyerWorkspaceId], references: [id], onDelete: Restrict)
  sellerWorkspace Workspace       @relation("SellerWorkspaceDeals", fields: [sellerWorkspaceId], references: [id], onDelete: Restrict)
  serviceOffering ServiceOffering @relation(fields: [serviceOfferingId], references: [id], onDelete: Restrict)
  projectBrief    ProjectBrief    @relation(fields: [projectBriefId], references: [id], onDelete: Restrict)
  projectRequest  ProjectRequest  @relation(fields: [projectRequestId], references: [id], onDelete: Restrict)
  // BG5: every Deal owns zero or more append-only TermsVersions.
  termsVersions   TermsVersion[]
  // BG6: every durable PaymentIntent anchored to this Deal. The
  // natural (dealId, termsVersionId) uniqueness accommodates one
  // intent per pinned (Deal, current TermsVersion) tuple; a
  // replacement TermsVersion creates a NEW intent and leaves the
  // stale one durable but activation-insufficient.
  paymentIntents  PaymentIntent[]

  @@index([buyerWorkspaceId, status, createdAt])
  @@index([sellerWorkspaceId, status, createdAt])
  @@map("deals")
}

// ===========================================================================
// Buildathon Golden Slice 5 (BG5) — DealApprover, TermsVersion, DealApproval
//
// BG5 introduces the minimum explicit DealApprover authorization required
// by the Golden Slice (GS 6 / DealApprover portion) and the immutable
// TermsVersion + independent DealApproval slice (GS 19-21, GS 26).
//
// CONTEXT.md ("DealApprover — A Workspace member explicitly authorized to
// approve an immutable TermsVersion for that Workspace.") makes the
// authorization an explicit row rather than inferred from Workspace
// capability, role, or membership. The (workspaceId, userId) natural
// uniqueness makes a single human's grant idempotent at the DB boundary.
//
// TermsVersions are append-only. A material change creates a new row with
// a monotonically incremented `version`; existing rows are never mutated.
// The unique (dealId, version) index is the second defense against
// retries creating duplicate version rows.
//
// DealApprovals are independent durable records bound to (Workspace,
// human actor, explicit DealApprover authorization, exact TermsVersion,
// timestamp). The unique (termsVersionId, workspaceId) index is the
// second defense against retries creating duplicate approvals for the
// same Workspace on the same version.
//
// All consequential references use onDelete: Restrict per CONTEXT.md
// ("Preserve immutable terms, approvals, delivery versions, and audit
// evidence in later milestones.").
// ===========================================================================

// DealApprover is the explicit authorization a Workspace grants to one
// of its current members to approve an immutable TermsVersion on the
// Workspace's behalf. A single Workspace may grant multiple
// authorizations (one per member), but the (workspaceId, userId)
// unique constraint prevents accidental duplicates. The authorization
// is recorded separately from WorkspaceCapability (Buyer/Seller) and
// from WorkspaceMembershipRole (Owner/Admin/Member); being a member, an
// Owner, or Buyer/Seller-capable does NOT record approval — only this
// row does.
model DealApprover {
  id                String   @id @default(cuid())
  workspaceId       String
  userId            String
  // The acting human who granted this authorization. Recorded for
  // audit; NOT an authorization source for the approval itself.
  grantedByUserId   String
  grantedAt         DateTime @default(now())

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user            UserAccount @relation("DealApproverUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy       UserAccount @relation("DealApproverGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  // Reverse relation: every DealApproval that cites this DealApprover.
  approvals DealApproval[]
  // M2 (#88): reverse relation on the DealApproverAcceptance
  // evidence table; a DealApprover row may have one or more
  // append-only acceptance rows that recorded who created it and which
  // confirmation version they accepted. The (workspaceId,
  // idempotencyKey) UNIQUE constraint on the acceptance table is the
  // authoritative convergence key — this reverse relation is purely
  // a Prisma convenience.
  acceptances     DealApproverAcceptance[]

  // One explicit authorization per (Workspace, user) tuple. A future
  // ticket that re-grants after revocation can either insert a new row
  // (with revokedAt/regrantedAt semantics not yet defined) or scope a
  // separate revokedAt column; BG5 ships idempotency only.
  @@unique([workspaceId, userId], map: "deal_approvers_workspace_user_unique_idx")
  @@index([workspaceId])
  @@index([userId])
  @@map("deal_approvers")
}

// M2 (#88): narrow append-only DealApproverAcceptance evidence.
//
// Personal-Workspace-only self-service provisioning of a `DealApprover`
// authorization. Every successful provisioning command creates ONE row
// that records:
//
//   - the (workspaceId, userId) tuple authorized (== DealApprover.id)
//   - the closed confirmation version the human accepted (e.g.
//     `m2-deal-approver-v1`); a stale or unknown version fails at the
//     application boundary with a typed error
//   - the actor (== `userId` for the Personal-Workspace self-service
//     path; the column is recorded separately from the acting user id
//     so a future Organization-grant flow can populate it from the
//     granting Owner/Admin without rewriting the column semantics)
//   - the request correlation id (mirrors every other evidence table)
//   - the client-supplied UUID idempotency key
//
// The (workspaceId, idempotencyKey) UNIQUE constraint is the durable
// convergence key for same-attempt transport retries; the application
// also performs the pre-check so this is the second defense, not the
// first.
//
// The acceptance row does NOT create a `DealApproval`; the Provisioning
// command is independent of any TermsVersion. JIT permission setup
// returns the human to the same pending Deal and current TermsVersion,
// where they must perform a separate explicit approval action.
//
// ON DELETE RESTRICT on every FK preserves the durable evidence row
// even if the source UserAccount, Workspace, or DealApprover is ever
// hard-deleted.
model DealApproverAcceptance {
  id                  String   @id @default(cuid())
  // The DealApprover authorization that this acceptance created (or
  // matched on retry). NOT a public DTO field; the public envelope
  // surfaces the bounded `dealApprover` shape only.
  dealApproverId      String
  workspaceId         String
  // The human member that became the authorized approver. Required.
  userId              String
  // The acting human who accepted the versioned attestation. For
  // Personal-Workspace self-service this is the same as `userId`;
  // the column is split so a future Organization-grant flow can
  // populate it from the granting Owner/Admin.
  grantedByUserId     String
  // Closed confirmation version the human accepted. The application
  // boundary enforces a single canonical value per slice; a stale
  // version is a typed rejection.
  confirmationVersion String
  acceptedAt          DateTime @default(now())
  // Client-supplied UUID generated when a new provisioning attempt
  // begins. Retained across uncertain transport outcomes and Retry
  // actions; cleared only on definitive success or user-initiated
  // payload change.
  idempotencyKey      String
  requestId           String

  dealApprover DealApprover @relation(fields: [dealApproverId], references: [id], onDelete: Restrict)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user         UserAccount  @relation("DealApproverAcceptanceUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy    UserAccount  @relation("DealApproverAcceptanceGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey], map: "deal_approver_acceptances_workspace_idem_unique_idx")
  @@index([dealApproverId])
  @@index([workspaceId, acceptedAt(sort: Desc)])
  @@map("deal_approver_acceptances")
}

// TermsVersion is an immutable proposal covering scope, deliverables,
// schedule, USD price in minor units, revision allowance, rights
// summary, and an optional funding deadline (display only). A material
// change creates a NEW row with a monotonically incremented `version`;
// existing rows are never mutated (CONTEXT.md: "A material edit creates
// a new version and invalidates prior approvals."). AI may draft the
// proposal but the row is visibly labeled as unapproved and the draft
// never synthesizes approval.
//
// The (dealId, version) unique index is the second defense against
// retries creating duplicate version rows; the service computes the
// next version under a transaction-scoped FOR UPDATE-locked max() so
// the gap-free monotonic invariant holds.
model TermsVersion {
  id                String   @id @default(cuid())
  dealId            String
  // Monotonically increasing per Deal. The first proposal is 1.
  // Computed under FOR UPDATE-lock by the service from MAX(version)+1;
  // a retry that re-uses the same version is rejected by the unique
  // index as a duplicate.
  version           Int
  // Free-form scope text the parties review. Persisted verbatim from
  // the validated AI output (or deterministic fallback).
  scope             String
  // One or more structured deliverable requirements.
  // JSON-encoded per `bg5DeliverableRequirementV1` in packages/types.
  deliverablesJson  Json
  // Start / end / deliveryDays structured schedule.
  // JSON-encoded per `bg5ScheduleV1` in packages/types.
  scheduleJson      Json
  // USD price in minor units (e.g. cents). Currency is fixed at USD for
  // BG5 per the Golden Slice spec.
  priceAmountMinor  Int
  priceCurrency     String
  // Maximum number of revision rounds the seller will deliver before
  // additional fees apply. Zero means no revisions.
  revisionAllowance Int
  // Short rights summary (e.g. "Buyer receives non-exclusive worldwide
  // rights for the commissioned work").
  rightsSummary     String
  // Optional funding deadline for display. The Golden Slice does NOT
  // enforce its passage; the application never reads this column as
  // an authorization source.
  fundingDeadlineAt DateTime?
  // AI provenance (mirrors the BG3 Matchmaker pattern). The values
  // document which AI adapter produced the candidate proposal; the
  // draft is never approved automatically.
  aiProvider        String
  aiModelId         String?
  aiFallbackUsed    Boolean
  // The acting human who triggered the draft (when known). Null when
  // the AI produced a purely background proposal that no human
  // explicitly requested; the column is optional so the service can
  // persist pure-AI drafts without inventing a user id.
  draftedByUserId   String?
  // When the proposal was first persisted. Recorded for audit and
  // displayed in the UI; this is NOT a deadline — the proposal is
  // immutable and persists until a replacement is created.
  draftedAt         DateTime
  createdAt         DateTime @default(now())

  deal            Deal              @relation(fields: [dealId], references: [id], onDelete: Restrict)
  draftedByUser   UserAccount?      @relation("TermsVersionDraftedBy", fields: [draftedByUserId], references: [id], onDelete: Restrict)
  // Reverse relation: every independent DealApproval that targets
  // this TermsVersion.
  approvals       DealApproval[]
  // BG6 reverse relation: every durable PaymentIntent that pinned
  // this version. The activation invariant re-checks
  // current-version, so a historical funding row pointing at a
  // superseded version is expected and harmless.
  paymentIntents  PaymentIntent[]

  // Natural uniqueness: a Deal has at most one row per version. A
  // retried draft that re-uses the same version is rejected as a
  // duplicate.
  @@unique([dealId, version], map: "terms_versions_deal_version_unique_idx")
  @@index([dealId, createdAt])
  @@map("terms_versions")
}

// DealApproval is an independent durable record that a Workspace, via
// an explicitly authorized DealApprover member, has approved an exact
// immutable TermsVersion. Buyer and seller approvals are separate rows;
// one party's approval does NOT synthesize the other party's approval.
//
// The row binds:
//   - TermsVersion (immutable target)
//   - Workspace (which side approved)
//   - approvedByUserId (the acting human — recorded for audit; NOT the
//     authorization source on its own)
//   - dealApproverId (the explicit authorization that permits the
//     approval; REQUIRED, not optional)
//   - approvedAt (post-persist timestamp supplied by the use case)
//
// The (termsVersionId, workspaceId) unique index is the second defense
// against retries creating duplicate approvals for the same Workspace
// on the same version; the service also checks the row's current-
// version invariant before persisting.
model DealApproval {
  id              String   @id @default(cuid())
  termsVersionId  String
  workspaceId     String
  // The explicit DealApprover authorization that permitted the
  // approval. REQUIRED — a missing authorization fails the approval
  // at the policy layer; the schema also enforces NOT NULL.
  dealApproverId  String
  approvedByUserId String
  approvedAt      DateTime

  termsVersion  TermsVersion @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  dealApprover  DealApprover @relation(fields: [dealApproverId], references: [id], onDelete: Restrict)
  approvedBy    UserAccount  @relation("DealApprovalApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  // Natural uniqueness: one approval per (TermsVersion, Workspace)
  // tuple. A retry on the same workspace + same version is rejected
  // by this index; the service also rejects it via a guarded insert.
  @@unique([termsVersionId, workspaceId], map: "deal_approvals_terms_workspace_unique_idx")
  @@index([workspaceId])
  @@index([dealApproverId])
  @@map("deal_approvals")
}

// ===========================================================================
// Buildathon Golden Slice 6 (BG6) — PaymentIntent + deterministic activation
//
// Per ticket #64 a PaymentIntent is a private PostgreSQL-authoritative
// record that durably exists BEFORE the escrow provider is called. The
// intent carries the exact Deal, the pinned current TermsVersion, the
// expected amount/currency, truthful asset/environment metadata, the
// provider state, and a SoundHub-owned opaque durable correlation
// identifier. The provider reference is added separately after the
// provider interaction.
//
// Lifecycle (providerState):
//   Created   — preauthorized + durably persisted; provider not called.
//   Confirmed — provider returned a matching confirmation; reference persisted.
//   Failed    — provider threw or returned a non-matching confirmation.
//
// (dealId, termsVersionId) is the natural-uniqueness key. A replacement
// TermsVersion (material change) may create a NEW intent; the stale one
// remains durable (immutable audit) but is no longer the CURRENT-version
// intent and therefore cannot satisfy the GS-25 condition 4 inside the
// activation transaction. Retries for the same (dealId, termsVersionId)
// converge on the SAME row — the find-or-create semantics inside the
// service guarantee this.
//
// All consequential references use ON DELETE RESTRICT per CONTEXT.md.
// ===========================================================================

model PaymentIntent {
  id                String                    @id @default(cuid())
  dealId            String
  termsVersionId    String
  // The acting Workspace that initiated funding. Recorded for audit;
  // the buyer's Workspace membership is what authorizes the command,
  // not this column. Always the Deal's buyerWorkspaceId.
  actingWorkspaceId String
  // The acting human who triggered funding. Recorded for audit; not
  // an authorization source on its own.
  createdByUserId   String
  // Exact USD amount in minor units the buyer expected to fund. Pinned
  // at intent creation time; the activation invariant re-verifies the
  // provider's confirmation matches this value bit-for-bit.
  expectedAmountMinor Int
  // Currency the buyer expected to fund. Fixed at "USD" for BG6; the
  // column is open for future currencies.
  expectedCurrency  String
  // Truthful asset label. The mock provider returns "sandbox-USDC";
  // the public DTO and UI surface this exact value so a real asset is
  // never claimed.
  assetLabel        String
  // Truthful network label. The mock provider returns
  // "simulated-network" — a generic synthetic label so no concrete
  // blockchain family is named. A future real PolkaAward adapter
  // returns its own truthful real-network label through the same
  // column; the BG6 application boundary remains provider-neutral.
  networkLabel      String
  // The provider key that owns this intent. Fixed at
  // "mock-escrow-deterministic" for BG6.
  providerKey       String
  // The environment label. Fixed at "sandbox" for the deterministic
  // mock; the UI surfaces this on every funding element.
  environmentLabel  String
  // SoundHub-owned opaque durable correlation identifier. Generated
  // by the application when the intent is first created; the provider
  // does NOT see this value (it is not an input). Persisted with
  // providerState = "Created" and never changes.
  correlationId     String                    @unique
  // The provider's own reference for the funding interaction. NULL
  // while providerState = "Created"; set when the provider returns a
  // matching or non-matching confirmation. The unique index is a
  // partial unique so the column is nullable.
  providerReference String?
  // When the provider returned the confirmation. NULL while
  // providerState = "Created".
  confirmedAt       DateTime?
  // When the SoundHub application accepted the confirmation. Same as
  // confirmedAt for the deterministic mock; kept separate for future
  // providers whose confirmation arrives asynchronously.
  acceptedAt        DateTime?
  // Closed sanitized reason code persisted when the intent transitions
  // to Failed. The closed category is captured in `failureDetailCategory`
  // (server-side log retains raw provider diagnostics; never persisted).
  failureReasonCode       PaymentIntentFailureReasonCode?
  // Closed sanitized failure-detail category. ONLY a value from the
  // `PaymentIntentFailureDetailCategory` enum may be persisted; raw
  // exception text, stack traces, hostnames, secrets, or stack-frame
  // diagnostics are NEVER persisted. See ticket #64 P1-004.
  failureDetailCategory   PaymentIntentFailureDetailCategory?
  // Closed lifecycle state. Defaults to "Created" so the row is
  // semantically meaningful immediately after persistence.
  providerState           PaymentIntentProviderState          @default(Created)
  createdAt               DateTime                            @default(now())
  updatedAt               DateTime                            @updatedAt

  deal            Deal         @relation(fields: [dealId], references: [id], onDelete: Restrict)
  termsVersion    TermsVersion @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)
  actingWorkspace Workspace    @relation(fields: [actingWorkspaceId], references: [id], onDelete: Restrict)
  createdByUser   UserAccount  @relation("PaymentIntentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // Natural uniqueness: one durable PaymentIntent per (Deal, pinned
  // current TermsVersion). A retried fundDeal command for the same
  // (dealId, termsVersionId) converges on this row via find-or-create.
  // A replacement TermsVersion creates a NEW intent; the stale one
  // remains durable and is activation-insufficient.
  @@unique([dealId, termsVersionId], map: "payment_intents_deal_version_unique_idx")
  // Provider reference uniqueness — partial so the column is nullable
  // while providerState = "Created".
  @@unique([providerReference], map: "payment_intents_provider_reference_unique_idx", where: { providerReference: { not: null } })
  @@index([dealId, createdAt])
  @@index([termsVersionId])
  @@index([actingWorkspaceId])
  @@map("payment_intents")
}
